<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="de-DE">
  <info>
    <title>Leitfaden zur Erstellung einer wissenschaftlichen Arbeit, Hochschule Osnabrück, Fakultät AuL (8. Auflage)</title>
    <id>pvp-kurs-leitfaden-hsos</id>
    <author><name>Modul Planung und Vorbereitung wissenschaftlicher Projekte</name></author>
    <category citation-format="author-date"/>
    <summary>Kurzbeleg im Text mit Namen in Großbuchstaben, z. B. (OMTA und BIJMANS 2007, S. 13); Literaturverzeichnis nach Abschnitt 3.3.7 des Leitfadens.</summary>
    <updated>2026-10-05T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="and">und</term>
      <term name="et-al">et al.</term>
      <term name="no date">o. J.</term>
      <term name="accessed">Zugriff am</term>
      <term name="editor" form="short">
        <single>Hrsg.</single>
        <multiple>Hrsg.</multiple>
      </term>
      <term name="page-range-delimiter"> – </term>
      <term name="page" form="short">
        <single>S.</single>
        <multiple>S.</multiple>
      </term>
    </terms>
    <date form="text">
      <date-part name="day" form="numeric" suffix=". "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </locale>

  <!-- Namen im Text: NACHNAME, zwei Personen mit "und", ab drei "et al." -->
  <macro name="autor-kurz">
    <names variable="author">
      <name form="short" and="text" delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher" text-case="uppercase"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- Namen im Verzeichnis: NACHNAME, V., NACHNAME2, V. (alle Personen) -->
  <macro name="autor-voll">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="publisher" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>

  <macro name="herausgeber">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="jahr">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>

  <macro name="verlag">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="seiten">
    <text variable="page"/>
  </macro>

  <macro name="kennung">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: "/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <date variable="accessed" form="text" prefix="(Zugriff am " suffix=")"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key macro="autor-kurz"/>
      <key macro="jahr"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="autor-kurz"/>
          <text macro="jahr"/>
        </group>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="1">
    <sort>
      <key macro="autor-kurz"/>
      <key macro="jahr"/>
    </sort>
    <layout suffix=".">
      <group delimiter=": ">
        <group delimiter=" ">
          <text macro="autor-voll"/>
          <text macro="jahr" prefix="(" suffix=")"/>
        </group>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=". ">
              <text variable="title"/>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text variable="container-title"/>
                  <text variable="volume"/>
                </group>
                <text macro="seiten"/>
              </group>
              <text macro="kennung"/>
            </group>
          </if>
          <else-if type="chapter paper-conference entry-encyclopedia" match="any">
            <group delimiter=". ">
              <text variable="title"/>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text value="In:"/>
                  <text macro="herausgeber"/>
                  <text variable="container-title" quotes="true"/>
                </group>
              </group>
              <group delimiter=", ">
                <text macro="verlag"/>
                <text macro="seiten"/>
              </group>
              <text macro="kennung"/>
            </group>
          </else-if>
          <else-if type="thesis">
            <group delimiter=". ">
              <text variable="title"/>
              <group delimiter=", ">
                <text variable="genre"/>
                <text variable="publisher"/>
              </group>
              <text macro="kennung"/>
            </group>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <group delimiter=". ">
              <text variable="title"/>
              <text macro="kennung"/>
            </group>
          </else-if>
          <else>
            <group delimiter=". ">
              <text variable="title"/>
              <text variable="collection-title"/>
              <text macro="verlag"/>
              <text macro="kennung"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
