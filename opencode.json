{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/assistent.md"
  ],
  "model": "openai/gpt-6-luna",
  "small_model": "opencode/space-bunny-free",
  "enabled_providers": [
    "openai",
    "opencode"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (Kursmodell)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "share": "disabled",
  "permission": {
    "edit": {
      "*": "ask",
      "expose/**": "ask",
      "kurs/**": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      "KI-Protokoll/**": "deny"
    },
    "bash": {
      "*": "ask",
      "quarto --version": "allow",
      "quarto render*": "allow",
      "quarto check*": "allow",
      "code --version": "allow",
      "positron --version": "allow",
      "ls": "allow",
      "ls *": "allow",
      "dir": "allow",
      "dir *": "allow",
      "Get-ChildItem": "allow",
      "Get-ChildItem *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
